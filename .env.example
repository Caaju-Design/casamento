# Conta de serviço do Google (Sheets + Drive API) — nunca preencher com valor real aqui
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Planilha que recebe as confirmações de presença (consumida pelo Looker Studio)
GOOGLE_SHEETS_RSVP_SPREADSHEET_ID=

# Pasta raiz no Google Drive, com uma subpasta por convidado
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Segredo usado para assinar/validar o token de convite (ver ADR-0003)
INVITE_TOKEN_SECRET=

# Limite de tamanho de upload de foto, em bytes (padrão: 10485760 = 10MB)
UPLOAD_MAX_FILE_SIZE_BYTES=10485760

# URL pública do site — usada só por scripts/generate-invite-links.mjs para montar o link de cada convidado
SITE_URL=https://casamento.caaju.com.br

# Código Pix "copia e cola" único, compartilhado por toda a lista de presentes (ver ADR-0002).
# O QR code é gerado a partir deste código — não precisa de imagem separada.
PIX_CODE=
