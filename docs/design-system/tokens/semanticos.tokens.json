{
  "color": {
    "background": {
      "page": { "$value": "{color.linho.50}", "$type": "color" },
      "surface": { "$value": "{color.white}", "$type": "color" },
      "accent": { "$value": "{color.pessego.50}", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "{color.caramelo.900}", "$type": "color" },
      "secondary": { "$value": "{color.caramelo.800}", "$type": "color" },
      "onAccent": { "$value": "{color.white}", "$type": "color" }
    },
    "border": {
      "subtle": { "$value": "{color.caramelo.100}", "$type": "color" },
      "focus": { "$value": "{color.ardosia.700}", "$type": "color" }
    },
    "action": {
      "primary": { "$value": "{color.terracota.500}", "$type": "color" },
      "primaryHover": { "$value": "{color.terracota.700}", "$type": "color" },
      "secondary": { "$value": "{color.salvia.800}", "$type": "color" },
      "highlight": { "$value": "{color.salvia.500}", "$type": "color" }
    },
    "feedback": {
      "error": { "$value": "{color.red.600}", "$type": "color" },
      "success": { "$value": "{color.salvia.800}", "$type": "color" }
    },
    "brand": {
      "logo": { "$value": "{color.salvia.500}", "$type": "color", "$description": "Cor da logo G&E" }
    }
  },
  "font": {
    "heading": { "$value": "{fontFamily.display}", "$type": "fontFamily" },
    "body": { "$value": "{fontFamily.body}", "$type": "fontFamily" },
    "script": { "$value": "{fontFamily.script}", "$type": "fontFamily" }
  },
  "spacing": {
    "sectionGap": { "$value": "{space.800}", "$type": "dimension" },
    "cardPadding": { "$value": "{space.400}", "$type": "dimension" },
    "fieldGap": { "$value": "{space.200}", "$type": "dimension" }
  },
  "radius": {
    "card": { "$value": "{radius.400}", "$type": "dimension" },
    "control": { "$value": "{radius.200}", "$type": "dimension" },
    "pill": { "$value": "{radius.full}", "$type": "dimension" }
  }
}
